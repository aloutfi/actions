#!/usr/bin/env bash
# tfpr: Terraform plan -> PR comment -> apply, as a portable bash + jq core.
#
# Usage: tfpr <command>
#   plan              init, workspace select, validate, plan; parse counts;
#                     write plan.json, plan.txt, plan-metadata.json
#   render            print the plan comment body to stdout (no CI/VCS calls)
#   comment           render the plan comment and upsert it on the current PR
#   decide            emit whether apply should fetch the planfile artifact
#   apply             stale re-run guard, plan-source decision, apply,
#                     apply-result comment on the commit's PR
#   resolve-plan-run  find the plan run for the PR that produced this commit
#
# Configuration comes from TFPR_* environment variables:
#   TFPR_STACK                      terraform directory and comment label (terraform/)
#   TFPR_WORKSPACE                  terraform workspace (default)
#   TFPR_EXIT_CODE                  render/comment: the plan's -detailed-exitcode
#   TFPR_RUN_ID, TFPR_JOB_URL       render: run link (comment fills these in)
#   TFPR_COMMENT_BUDGET             render: max plan.txt bytes in the comment
#   TFPR_COMMENT_AUTHOR             comment/apply: login allowed to own the comment
#   TFPR_USE_PLANFILE               decide/apply: apply the stored planfile (false)
#   TFPR_ALLOW_FRESH_PLAN_FALLBACK  apply: fresh-plan if the planfile is missing (false)
#   TFPR_PLAN_RUN_ID                apply: run that produced the planfile (comment only)
#   TFPR_LOCK_TIMEOUT               apply: -lock-timeout (5m)
#   TFPR_PLAN_WORKFLOW              resolve-plan-run: plan workflow file name
#   TFPR_VCS                        repo-host adapter under lib/vcs/ (github)
#
# The core touches the CI platform and repo host only through the adapter
# functions documented in lib/README.md.
set -euo pipefail

TFPR_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TFPR_STACK="${TFPR_STACK:-terraform/}"
TFPR_WORKSPACE="${TFPR_WORKSPACE:-default}"
# GitHub caps comments at 65,536 chars; this leaves room for the rest of the body.
TFPR_COMMENT_BUDGET="${TFPR_COMMENT_BUDGET:-45000}"

die() {
  if declare -F ci_error > /dev/null; then ci_error "$*"; else echo "tfpr: $*" >&2; fi
  exit 1
}

load_ci() {
  if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
    # shellcheck source=/dev/null
    source "${TFPR_ROOT}/lib/ci/github.sh"
  else
    die "no supported CI detected (expected GITHUB_ACTIONS=true)"
  fi
}

load_vcs() {
  local vcs="${TFPR_VCS:-github}"
  [[ "${vcs}" =~ ^[a-z]+$ && -f "${TFPR_ROOT}/lib/vcs/${vcs}.sh" ]] || die "unknown TFPR_VCS '${vcs}'"
  # shellcheck source=/dev/null
  source "${TFPR_ROOT}/lib/vcs/${vcs}.sh"
  # shellcheck disable=SC2034 # read by the VCS adapter
  TFPR_REPO="${TFPR_REPO:-$(ci_repo)}"
}

# ---------------------------------------------------------------------------
# Pure helpers (no CI or VCS calls; unit-tested in test/run.sh)
# ---------------------------------------------------------------------------

# artifact_name STACK WORKSPACE -> tfplan-<slug>-<workspace>
# Shared by plan (upload) and apply (download); the names must match.
artifact_name() {
  local slug
  # Slug: replace /. with -, strip non-alphanumeric/dash, collapse dashes, trim ends.
  slug="$(echo "$1" | tr '/.' '--' | tr -cd '[:alnum:]-' | sed 's/--*/-/g; s/^-//; s/-$//')"
  echo "tfplan-${slug}-${2:-default}"
}

# Fields printed by plan_stats, in order. They are also tfpr plan's step outputs.
PLAN_STATS=(creates updates destroys replaces imports forgets moves output_changes
  has_changes has_imports has_output_changes summary)

# plan_stats PLAN_JSON -> one TSV line of PLAN_STATS.
# terraform show -json emits resource_changes[] with change.actions =
# ["no-op"|"create"|"read"|"update"|"delete"|"forget"] or ["create","delete"]
# for replace; change.importing = { id: "..." } for imports; previous_address
# for moved resources. forget comes from removed { lifecycle { destroy = false } }.
# Forgets and moves change state, so they count toward has_changes.
# Callers read it with: local "${PLAN_STATS[@]}"; IFS=$'\t' read -r "${PLAN_STATS[@]}"
plan_stats() {
  jq -r '
    [.resource_changes[]?] as $rc
    | {
        creates:  [$rc[] | select(.change.actions | index("create")) | select(.change.actions | index("delete") | not)] | length,
        updates:  [$rc[] | select(.change.actions == ["update"])] | length,
        destroys: [$rc[] | select(.change.actions | index("delete")) | select(.change.actions | index("create") | not)] | length,
        replaces: [$rc[] | select(.change.actions | (index("create") and index("delete")))] | length,
        imports:  [$rc[] | select(.change.importing != null)] | length,
        forgets:  [$rc[] | select(.change.actions | index("forget"))] | length,
        moves:    [$rc[] | select(.previous_address != null and .previous_address != .address)] | length,
        output_changes: [.output_changes[]? | select(.actions != ["no-op"])] | length
      }
    | .has_changes = (.creates + .updates + .destroys + .replaces + .forgets + .moves > 0)
    | .has_imports = (.imports > 0)
    | .has_output_changes = (.output_changes > 0)
    | .summary = "\(.creates) to add, \(.updates) to change, \(.destroys) to destroy, \(.replaces) to replace, \(.imports) to import"
        + (if .forgets > 0 then ", \(.forgets) to forget" else "" end)
        + (if .moves > 0 then ", \(.moves) to move" else "" end)
    | [.creates, .updates, .destroys, .replaces, .imports, .forgets, .moves, .output_changes,
       .has_changes, .has_imports, .has_output_changes, .summary]
    | @tsv
  ' "$1"
}

plan_marker() { echo "<!-- tf-plan:${1} :: ${2:-default} -->"; }
apply_marker() { echo "<!-- tf-apply:${1} :: ${2:-default} -->"; }

# decide_plan_source USE_PLANFILE ATTEMPT HAS_PLANFILE ALLOW_FALLBACK
# Prints "<source> [reason]"; source is planfile | fresh | none.
decide_plan_source() {
  local use_planfile="$1" attempt="$2" has_planfile="$3" allow_fallback="$4"
  if [[ "${use_planfile}" != "true" ]]; then
    echo "fresh no-artifact-requested"
  elif [[ "${attempt}" -gt 1 ]]; then
    # The stored plan reflects state before the failed attempt; applying it
    # risks "Saved plan is stale" or a partial roll-forward. The re-run applies
    # a fresh plan instead, which the stale re-run guard limits to the branch head.
    echo "fresh rerun"
  elif [[ "${has_planfile}" == "true" ]]; then
    echo "planfile"
  elif [[ "${allow_fallback}" == "true" ]]; then
    echo "fresh missing-artifact"
  else
    # Fail closed: the reviewed plan is gone, and an unreviewed -auto-approve
    # apply is exactly what the planfile flow exists to prevent.
    echo "none missing-artifact"
  fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

# shellcheck disable=SC2154 # PLAN_STATS locals are assigned by read
cmd_plan() {
  load_ci
  local code=0 stats stat name
  local "${PLAN_STATS[@]}"
  name="$(artifact_name "${TFPR_STACK}" "${TFPR_WORKSPACE}")"
  cd "${TFPR_STACK}"

  terraform init -input=false
  terraform workspace select -or-create "${TFPR_WORKSPACE}"
  terraform validate -no-color
  # -detailed-exitcode: 0 = no changes, 1 = error, 2 = changes. Only 1 fails.
  terraform plan -input=false -no-color -detailed-exitcode -out=tfplan || code=$?
  ci_output exit_code "${code}"
  [[ "${code}" -ne 1 ]] || return 1

  terraform show -json tfplan > plan.json
  terraform show -no-color tfplan > plan.txt
  stats="$(plan_stats plan.json)"
  IFS=$'\t' read -r "${PLAN_STATS[@]}" <<< "${stats}"
  for stat in "${PLAN_STATS[@]}"; do
    ci_output "${stat}" "${!stat}"
  done
  ci_output plan_artifact_name "${name}"

  jq -n \
    --arg sha "$(ci_sha)" \
    --arg pr_number "$(ci_pr)" \
    --arg actor "$(ci_actor)" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --arg stack "${TFPR_STACK}" \
    --arg workspace "${TFPR_WORKSPACE}" \
    --arg terraform_version "$(terraform_version)" \
    --argjson has_changes "${has_changes}" \
    --argjson has_imports "${has_imports}" \
    '$ARGS.named' > plan-metadata.json
}

# shellcheck disable=SC2154 # PLAN_STATS locals are assigned by read
cmd_render() {
  local dir="${TFPR_STACK}" stack="${TFPR_STACK}" ws="${TFPR_WORKSPACE:-default}"
  local exit_code="${TFPR_EXIT_CODE:?TFPR_EXIT_CODE is required}"
  local run_id="${TFPR_RUN_ID:-}" job_url="${TFPR_JOB_URL:-}" budget="${TFPR_COMMENT_BUDGET}"
  local stats status_icon counts_phrase details_open plan_txt diff_summary
  local "${PLAN_STATS[@]}"

  stats="$(plan_stats "${dir}/plan.json")"
  IFS=$'\t' read -r "${PLAN_STATS[@]}" <<< "${stats}"

  status_icon="✅"
  [[ "${has_output_changes}" == "true" ]] && status_icon="🔸"
  [[ "${has_changes}" == "true" ]] && status_icon="📝"
  [[ "${has_imports}" == "true" ]] && status_icon="📥"

  if [[ "${has_changes}" == "true" || "${has_imports}" == "true" ]]; then
    counts_phrase="${summary}"
    details_open=" open"
  elif [[ "${has_output_changes}" == "true" ]]; then
    # Output-only plan (exit 2, zero resource changes) is still a real diff:
    # outputs feed terraform_remote_state consumers. Expand it instead of
    # rendering a collapsed "No changes".
    counts_phrase="No resource changes — ${output_changes} output change(s)"
    details_open=" open"
  else
    counts_phrase="No changes"
    details_open=""
  fi

  # Truncate plan.txt to keep the comment under the host's size limit. The
  # full plan is in the tfplan artifact (terraform show tfplan).
  plan_txt="$(head -c "${budget}" "${dir}/plan.txt")"
  if [[ "$(wc -c < "${dir}/plan.txt")" -gt "${budget}" ]]; then
    plan_txt="$(printf '%s\n\n%s' "${plan_txt}" \
      "[truncated — download the tfplan artifact and run \`terraform show tfplan\` for full output]")"
  fi

  # Color-coded diff summary from terraform's "  # X will be ..." lines, in a
  # ```diff fence: additions green, deletions red, updates/replaces amber.
  diff_summary="$(grep -E '^[[:space:]]*# ' "${dir}/plan.txt" | sed \
    -e 's|^[[:space:]]*# \(.*will be created\)$|+ \1|' \
    -e 's|^[[:space:]]*# \(.*will be imported\)$|+ \1|' \
    -e 's|^[[:space:]]*# \(.*will be destroyed\)$|- \1|' \
    -e 's|^[[:space:]]*# \(.*will be updated in-place\)$|! \1|' \
    -e 's|^[[:space:]]*# \(.*will be replaced.*\)$|! \1|' \
    -e 's|^[[:space:]]*# \(.*must be replaced.*\)$|! \1|' \
    -e 's|^[[:space:]]*# \(.*will be read during apply.*\)$|~ \1|' \
    -e 's|^[[:space:]]*# \(.*\)$|# \1|' \
    || true)"

  # Outer wrap is open when there is something to review, collapsed otherwise.
  plan_marker "${stack}" "${ws}"
  echo "<details${details_open}>"
  echo "<summary>${status_icon} <b>Terraform Plan</b> — <code>${stack}</code> (<code>${ws}</code>) — ${counts_phrase}</summary>"
  echo ""
  echo "**Exit code:** \`${exit_code}\`  "
  echo "**Job:** [#${run_id}](${job_url})"
  echo ""
  echo "| Add | Change | Destroy | Replace | **Import** | Forget | Move | Outputs |"
  echo "|---|---|---|---|---|---|---|---|"
  echo "| ${creates} | ${updates} | ${destroys} | ${replaces} | **${imports}** | ${forgets} | ${moves} | ${output_changes} |"
  echo ""
  if [[ -n "${diff_summary}" ]]; then
    echo "<details${details_open}><summary>🚦 Diff summary</summary>"
    echo ""
    echo '```diff'
    echo "${diff_summary}"
    echo '```'
    echo ""
    echo "</details>"
    echo ""
  fi
  echo "<details${details_open}><summary>⚙️ Full terraform plan output</summary>"
  echo ""
  echo '```terraform'
  echo "${plan_txt}"
  echo '```'
  echo ""
  echo "</details>"
  echo ""
  echo "</details>"
}

cmd_comment() {
  load_ci
  load_vcs
  local pr body
  pr="$(ci_pr)"
  if [[ -z "${pr}" ]]; then
    echo "Not a pull request build; skipping plan comment."
    return 0
  fi
  TFPR_RUN_ID="$(ci_run_id)"
  TFPR_JOB_URL="$(ci_job_url)"
  body="$(mktemp)"
  cmd_render > "${body}"
  vcs_upsert_comment "${pr}" "$(plan_marker "${TFPR_STACK}" "${TFPR_WORKSPACE}")" "${body}" "${TFPR_COMMENT_AUTHOR:-}"
}

cmd_decide() {
  load_ci
  local source download=false
  read -r source _ <<< "$(decide_plan_source "${TFPR_USE_PLANFILE:-false}" "$(ci_attempt)" true false)"
  [[ "${source}" == "planfile" ]] && download=true
  ci_output download "${download}"
  ci_output artifact_name "$(artifact_name "${TFPR_STACK}" "${TFPR_WORKSPACE}")"
}

# On attempt > 1 the stored planfile is skipped, so a re-run fresh-applies this
# run's tree with -auto-approve. If the branch has moved on, that tree is
# superseded: a re-run of an older merge once applied a superseded tree and
# destroyed newer resources. Fail closed: only the branch head may re-run.
stale_rerun_guard() {
  local ref sha head attempt
  ref="$(ci_ref)"
  sha="$(ci_sha)"
  attempt="$(ci_attempt)"
  if [[ "${ref}" != refs/heads/* ]]; then
    ci_error "Re-run apply refused: cannot verify staleness for non-branch ref '${ref}'. Trigger a fresh run instead."
    return 1
  fi
  head="$(vcs_branch_head "${ref#refs/heads/}")" || return 1
  if [[ "${head}" != "${sha}" ]]; then
    ci_error "Re-run apply refused (attempt=${attempt}): commit ${sha} is no longer the head of '${ref#refs/heads/}' (now ${head}). A fresh-plan apply of a superseded tree would roll back later merges. Re-run the newest merge run for this stack, or land the change via a PR."
    return 1
  fi
  echo "Re-run staleness check passed: ${sha} is still the head of '${ref#refs/heads/}'."
}

terraform_version() { terraform version -json 2> /dev/null | jq -r .terraform_version || echo unknown; }

# terraform_apply planfile|fresh. Runs in a subshell so the first failure's
# exit code propagates even when called from an `||` context.
terraform_apply() {
  local args=(-input=false -no-color "-lock-timeout=${TFPR_LOCK_TIMEOUT:-5m}")
  if [[ "$1" == "planfile" ]]; then
    # The reviewed planfile encodes intent; no -auto-approve needed.
    args+=(tfplan)
  else
    args+=(-auto-approve)
  fi
  (
    cd "${TFPR_STACK}" &&
      terraform init -input=false &&
      terraform workspace select -or-create "${TFPR_WORKSPACE}" &&
      terraform apply "${args[@]}"
  )
}

cmd_apply() {
  load_ci
  load_vcs
  local use_planfile="${TFPR_USE_PLANFILE:-false}" allow="${TFPR_ALLOW_FRESH_PLAN_FALLBACK:-false}"
  local attempt source=none reason="" code=0 has_planfile=false used=false
  attempt="$(ci_attempt)"

  if [[ "${attempt}" -gt 1 ]] && ! stale_rerun_guard; then
    reason="stale-rerun"
    code=1
  else
    [[ -f "${TFPR_STACK}/tfplan" ]] && has_planfile=true
    read -r source reason <<< "$(decide_plan_source "${use_planfile}" "${attempt}" "${has_planfile}" "${allow}")"
    case "${source}:${reason}" in
      fresh:rerun)
        ci_warn "Re-run detected (attempt=${attempt}); skipping stored planfile to avoid stale-plan apply" ;;
      fresh:missing-artifact)
        ci_warn "Planfile artifact requested but not found; falling back to fresh-plan apply (allow_fresh_plan_fallback=true)" ;;
      none:missing-artifact)
        ci_error "Planfile artifact requested but not found; refusing to apply a fresh, unreviewed plan. Set allow_fresh_plan_fallback=true to opt in."
        code=1 ;;
      planfile:)
        echo "Found planfile from artifact; will apply it" ;;
    esac
    # A partial-apply failure must propagate so downstream jobs see it.
    if [[ "${source}" != "none" ]]; then
      terraform_apply "${source}" || code=$?
    fi
  fi

  [[ "${source}" == "planfile" ]] && used=true
  ci_output apply_exit_code "${code}"
  ci_output used_plan_artifact "${used}"
  ci_output fallback_reason "${reason}"
  post_apply_comment "${code}" "${source}" "${reason}" "${used}" "${use_planfile}" "${attempt}"
  return "${code}"
}

post_apply_comment() {
  local code="$1" source="$2" reason="$3" used="$4" use_planfile="$5" attempt="$6"
  local sha pr stack="${TFPR_STACK}" ws="${TFPR_WORKSPACE:-default}" plan_run="${TFPR_PLAN_RUN_ID:-}"
  local status_icon status_text source_line artifact="n/a" run_id run_url body
  sha="$(ci_sha)"

  # Not every apply comes from a PR merge (drift, manual dispatch); skip quietly.
  pr="$(vcs_pr_for_commit "${sha}" 2> /dev/null | head -n 1 | cut -d' ' -f1 || true)"
  if [[ -z "${pr}" ]]; then
    echo "No PR associated with ${sha}; skipping apply-result comment."
    return 0
  fi

  if [[ "${code}" == "0" ]]; then
    status_icon="✅"
    status_text="succeeded"
  else
    status_icon="❌"
    status_text="failed (exit ${code})"
  fi

  case "${source}:${reason}" in
    planfile:*) source_line="planfile from PR review (run #${plan_run:-current})" ;;
    fresh:rerun) source_line="fresh plan (rerun bypass)" ;;
    fresh:missing-artifact) source_line="fresh plan (artifact missing)" ;;
    none:missing-artifact) source_line="none (planfile artifact missing; fresh-plan fallback not allowed)" ;;
    none:stale-rerun) source_line="none (stale re-run refused)" ;;
    *) source_line="fresh plan" ;;
  esac

  if [[ "${use_planfile}" == "true" && "${attempt}" -le 1 ]]; then
    artifact="$(artifact_name "${stack}" "${ws}")"
  fi
  run_id="$(ci_run_id)"
  run_url="$(ci_run_url)"

  body="$(mktemp)"
  {
    apply_marker "${stack}" "${ws}"
    echo "## ${status_icon} Terraform Apply — \`${stack}\` (\`${ws}\`) — ${status_text}"
    echo ""
    echo "**Source:** ${source_line}  "
    echo "**Run:** [${run_id}](${run_url})  "
    echo "**Commit:** \`${sha}\`"
    echo ""
    echo "<details><summary>Debug</summary>"
    echo ""
    echo "| Field | Value |"
    echo "|---|---|"
    echo "| Stack | \`${stack}\` |"
    echo "| Workspace | \`${ws}\` |"
    echo "| Used planfile | \`${used}\` |"
    echo "| Planfile artifact | \`${artifact}\` |"
    echo "| Planfile source run | \`${plan_run:-(current run)}\` |"
    echo "| Fallback reason | \`${reason:-n/a}\` |"
    echo "| Apply exit code | \`${code}\` |"
    echo "| Terraform version | \`$(terraform_version)\` |"
    echo ""
    echo "</details>"
  } > "${body}"

  vcs_upsert_comment "${pr}" "$(apply_marker "${stack}" "${ws}")" "${body}" "${TFPR_COMMENT_AUTHOR:-}"
}

cmd_resolve_plan_run() {
  load_ci
  load_vcs
  local workflow="${TFPR_PLAN_WORKFLOW:?TFPR_PLAN_WORKFLOW is required}"
  local attempt sha prs count pr_num="" head_sha="" run_id=""
  attempt="$(ci_attempt)"
  sha="$(ci_sha)"

  if [[ "${attempt}" -gt 1 ]]; then
    # Re-run: the stored plan reflects state before the failed apply. Emit
    # nothing so apply takes the fresh-plan path.
    ci_notice "Re-run detected (attempt=${attempt}); fresh-plan fallback"
  else
    prs="$(vcs_pr_for_commit "${sha}")"
    count="$(grep -c . <<< "${prs}" || true)"
    if [[ "${count}" -eq 0 ]]; then
      ci_notice "No PR associated with ${sha}; direct-push or hotfix path; fresh-plan fallback"
    elif [[ "${count}" -gt 1 ]]; then
      # Multiple PRs (merge queue, cherry-pick): don't guess.
      ci_warn "Multiple PRs match ${sha} (count=${count}); fresh-plan fallback to avoid ambiguity"
    else
      read -r pr_num head_sha <<< "${prs}"
      run_id="$(vcs_find_plan_run "${workflow}" "${head_sha}")"
      if [[ -z "${run_id}" ]]; then
        ci_notice "No successful '${workflow}' run found for head_sha=${head_sha} (PR #${pr_num}); fresh-plan fallback"
      else
        echo "Resolved PR #${pr_num} head=${head_sha} → plan run=${run_id}"
      fi
    fi
  fi

  ci_output run_id "${run_id}"
  ci_output pr_number "${pr_num}"
}

main() {
  local cmd="${1:-}"
  case "${cmd}" in
    plan) cmd_plan ;;
    render) cmd_render ;;
    comment) cmd_comment ;;
    decide) cmd_decide ;;
    apply) cmd_apply ;;
    resolve-plan-run) cmd_resolve_plan_run ;;
    *) die "usage: tfpr plan|render|comment|decide|apply|resolve-plan-run" ;;
  esac
}

# Run only when executed, so tests can source the helpers.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
